# Base de données PostgreSQL (Obligatoire)
# Local Docker: postgresql://opt_user:opt_password@localhost:5432/opt_db?schema=public
# Render / Supabase / Neon: Remplacer par votre chaîne de connexion PostgreSQL avec SSL
DATABASE_URL="postgresql://opt_user:opt_password@localhost:5432/opt_db?schema=public"

# Environnement
NODE_ENV="production"
PORT=3000
